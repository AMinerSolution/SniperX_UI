# --- LLM ---
# Leave blank to run fully offline with the deterministic FakeLLM.
ANTHROPIC_API_KEY=
SWARM_LLM=auto            # auto | fake | anthropic
MODEL_CHEAP=claude-haiku-5-5
MODEL_MID=claude-sonnet-5-5
MODEL_TOP=claude-opus-5-5

# --- Safety rails ---
DRY_RUN=true              # true = nothing ever leaves the system (drafts + outbox table only)
DAILY_SEND_CAP=20
MIN_SCORE=60

# --- CAN-SPAM compliance (appended to every email by code, not by the LLM) ---
SENDER_NAME=
SENDER_COMPANY=SupliiChain
SENDER_ADDRESS=           # physical mailing address, REQUIRED before DRY_RUN=false

# --- Providers (stubs until implemented) ---
DISCOVERY=csv             # csv | apollo
RESEARCH=fixture          # fixture | web
SENDER=dryrun             # dryrun | instantly
APOLLO_API_KEY=
INSTANTLY_API_KEY=
SWARM_DB=.data/swarm.db

# --- API for the Next.js approval UI ---
SWARM_API_TOKEN=          # REQUIRED to start the API. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
